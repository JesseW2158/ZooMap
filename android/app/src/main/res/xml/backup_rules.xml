<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 (API 23-30) full-backup rules: back up nothing. See data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
