# Copy to .env.local and fill in. Never commit .env.local.
# Each parallel worktree uses its own MONGODB_DB (for example zoomap_density);
# tests run in `${MONGODB_DB}_test`.

# --- Database ---------------------------------------------------------------
MONGODB_URI=
MONGODB_DB=zoomap

# --- Sign-in ----------------------------------------------------------------
# `npx auth secret` or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Checked on the server from the verified token claims.
ALLOWED_EMAIL_DOMAINS=umass.edu
# 1 enables sign-in as a seed user. Refused when NODE_ENV=production.
DEV_AUTH=

# --- Schedule ---------------------------------------------------------------
# Hosts a calendar feed link may point at. A leading dot matches subdomains.
ICS_ALLOWED_HOSTS=.instructure.com,calendar.google.com
# 32 bytes, base64: AES-256-GCM key for stored calendar secrets.
ENCRYPTION_KEY=

# --- Recommend --------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Density, activities, rewards -------------------------------------------
# 1 turns the simulated density source on.
SIMULATED_DENSITY=1
# Live counts below this are dropped. 1 is for the demo; use 3 or more for a real launch.
DENSITY_MIN_LIVE_COUNT=1
# 0 skips the distance check for presenting.
GEOFENCE_ENFORCED=1
# Raise it for the demo so two minutes earn visible points.
POINTS_PER_MINUTE=1

# --- Client (inlined into the browser bundle) --------------------------------
# 1 enables the click-to-set-location override. Leave unset in production.
NEXT_PUBLIC_DEV_TOOLS=
# Deployed origin, used by the Android shell.
NEXT_PUBLIC_APP_URL=http://localhost:3000
